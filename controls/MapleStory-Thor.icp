{
  "schemaVersion": 1,
  "name": "MapleStory Classic World - Thor",
  "includedSections": ["physicalController", "radialMenu"],
  "leftStickDeadzone": 0.15,
  "rightStickDeadzone": 0.15,
  "leftStickSensitivity": 1.0,
  "rightStickSensitivity": 0.8,
  "leftStickDeadzoneMode": "circular",
  "rightStickDeadzoneMode": "circular",
  "leftStickDigitalMode": "eight_way",
  "rightStickDigitalMode": "unrestricted",
  "controllers": [
    {
      "id": "*",
      "name": "Thor / any gamepad",
      "controllerBindings": [
        {"keyCode": -1, "binding": "KEY_LEFT"},
        {"keyCode": -2, "binding": "KEY_RIGHT"},
        {"keyCode": -3, "binding": "KEY_DOWN"},
        {"keyCode": -4, "binding": "KEY_UP"},
        {"keyCode": -5, "binding": "MOUSE_MOVE_LEFT"},
        {"keyCode": -6, "binding": "MOUSE_MOVE_RIGHT"},
        {"keyCode": -7, "binding": "MOUSE_MOVE_DOWN"},
        {"keyCode": -8, "binding": "MOUSE_MOVE_UP"},
        {"keyCode": 96, "binding": "KEY_ALT_L"},
        {"keyCode": 97, "binding": "KEY_SPACE"},
        {"keyCode": 99, "binding": "KEY_CTRL_L"},
        {"keyCode": 100, "binding": "KEY_Z"},
        {"keyCode": 102, "binding": "KEY_Q"},
        {"keyCode": 103, "binding": "KEY_W"},
        {"keyCode": 104, "binding": "KEY_E"},
        {"keyCode": 105, "binding": "OPEN_RADIAL_MENU"},
        {"keyCode": 108, "binding": "KEY_ESC"},
        {"keyCode": 109, "binding": "KEY_I"},
        {"keyCode": 106, "binding": "KEY_N"},
        {"keyCode": 107, "binding": "MOUSE_LEFT_BUTTON"},
        {"keyCode": 19, "binding": "KEY_UP"},
        {"keyCode": 22, "binding": "KEY_RIGHT"},
        {"keyCode": 20, "binding": "KEY_DOWN"},
        {"keyCode": 21, "binding": "KEY_LEFT"}
      ]
    }
  ],
  "radialMenus": [
    {
      "id": "default",
      "name": "MapleStory menus",
      "slots": [
        {"label": "Inventory", "binding": "KEY_I"},
        {"label": "Equipment", "binding": "KEY_U"},
        {"label": "Skills", "binding": "KEY_K"},
        {"label": "Stats", "binding": "KEY_Y"},
        {"label": "Quests", "binding": "KEY_J"},
        {"label": "Map", "binding": "KEY_N"},
        {"label": "Confirm", "binding": "KEY_ENTER"},
        {"label": "Keyboard", "binding": "SHOW_KEYBOARD"}
      ]
    }
  ]
}
